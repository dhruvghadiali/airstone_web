{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@commonComponent/*": [
        "./src/components/common/*"
      ],
      "@screenComponent/*": [
        "./src/components/screen/*"
      ],
      "@page/*": [
        "./src/pages/*"
      ],
      "@shadcnComponent/*": [
        "./src/components/ui/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@redux/*": [
        "./src/store/*"
      ],
      "@commonComponent": [
        "./src/components/common"
      ],
      "@screenComponent": [
        "./src/components/screen"
      ],
      "@page": [
        "./src/pages"
      ],
      "@shadcnComponent": [
        "./src/components/ui"
      ],
      "@lib": [
        "./src/lib"
      ],
      "@redux": [
        "./src/store"
      ]
    }
  }
}
